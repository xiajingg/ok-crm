# ============================================================================
# 复制为 .env 后修改。生产环境务必替换所有密码与密钥。
#   cp .env.example .env
# 生成密钥：openssl rand -base64 48
# ============================================================================

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- 后端 ----------
# 后端端口。本机启动脚本用它；Docker 下是宿主机映射端口（容器内固定 8080）
BACKEND_PORT=9001

# JWT 签名密钥，HS256 要求至少 32 字节
JWT_SECRET=change-me-please-use-openssl-rand-base64-48-output
JWT_EXPIRE_MINUTES=720

# ---------- 部署初始化（单企业私有化部署）----------
# 首次启动时按这些值自动创建企业信息（幂等，已存在则跳过）。
# 客户拿到包之后只需要改这一段，启动即完成部署，不需要执行任何 SQL。
TENANT_ID=1
TENANT_CODE=acme
# 企业名称，显示在管理后台左上角与登录页
TENANT_NAME=某某科技有限公司
TENANT_REGION=CN-HUBEI
TENANT_REGION_NAME=湖北
TENANT_TIMEZONE=Asia/Shanghai
TENANT_CURRENCY=CNY
TENANT_CONTACT_NAME=
TENANT_CONTACT_PHONE=

# 初始管理员账号。
# ADMIN_PASSWORD 留空则自动生成随机强密码，并打印到启动日志（推荐）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 忘记管理员密码时用它重置（非空即生效，每次启动都会重置，用完请删掉本行）
# ADMIN_RESET_PASSWORD=

# 公海池自动回收任务
POOL_RECYCLE_ENABLED=true
POOL_RECYCLE_CRON=0 0 2 * * ?

# ---------- 前端 ----------
WEB_PORT=80
