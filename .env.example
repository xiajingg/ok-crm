# ============================================================================
# 复制为 .env 后修改。生产环境务必替换所有密码与密钥。
#   cp .env.example .env
# 生成密钥：openssl rand -base64 48
# ============================================================================

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- 后端 ----------
# 后端端口。本机启动脚本用它；Docker 下是宿主机映射端口（容器内固定 8080）
BACKEND_PORT=9001

# JWT 签名密钥，HS256 要求至少 32 字节
JWT_SECRET=change-me-please-use-openssl-rand-base64-48-output
JWT_EXPIRE_MINUTES=720

# 平台超管（不属于任何租户，用于开通租户与模块授权）
PLATFORM_ADMIN_ENABLED=true
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# 开通租户时自动创建的租户管理员
TENANT_ADMIN_USERNAME=admin
TENANT_ADMIN_PASSWORD=change-me-strong-password

# 公海池自动回收任务
POOL_RECYCLE_ENABLED=true
POOL_RECYCLE_CRON=0 0 2 * * ?

# ---------- 前端 ----------
WEB_PORT=80
